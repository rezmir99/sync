[Unit]
Description=xray
After=network.target

[Service]
Type=simple
ExecStart=/root/xray-core/xray run config.json
WorkingDirectory=/root/xray-core
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
Restart=on-failure
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
